rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Case-insensitive so "Hiring" / typos in casing don't break ATS writes.
    function isHiringRole(r) {
      return r is string && lower(r) == 'hiring';
    }

    function isHiring() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        isHiringRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role);
    }

    // Users collection
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Candidate profiles
    match /candidateProfiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // Employee profiles — owner or hiring committee (karma)
    match /employeeProfiles/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && (
        request.auth.uid == uid ||
        isHiring()
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Referral requests — get is strict (participant only), list allows any
    // authenticated user. Same OR-condition fix as shadowInterviews.
    match /referralRequests/{requestId} {
      allow get: if request.auth != null && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );
    }

    // Pipeline — readable by the employee who created it or hiring
    match /pipeline/{pipelineId} {
      // Keep pipeline list/get resilient across employee + hiring listeners.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.employeeId == request.auth.uid ||
        isHiring()
      );
      allow delete: if request.auth != null && (
        resource.data.employeeId == request.auth.uid ||
        isHiring()
      );
    }

    // Activity feed — readable by the user it belongs to
    match /activity/{activityId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
    }

    // Shadow Interviews — get is strict (participant only), list allows any
    // authenticated user because Firestore can't validate OR conditions on
    // collection queries. Client queries already filter by candidateId/employeeId.
    match /shadowInterviews/{interviewId} {
      allow get: if request.auth != null && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );
      allow list: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.employeeId == request.auth.uid
      );
    }

    // Hiring committee ATS
    match /referrals/{referralId} {
      allow read, write: if isHiring();
    }

    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if isHiring();
    }

    match /dashboard_stats/{docId} {
      allow read, write: if isHiring();
    }

    // Seeding metadata
    match /_meta/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
