GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Comma-separated. The app auto-adds the 127.0.0.1 mirror for each localhost origin (and vice versa).
CORS_ORIGINS=http://localhost:5173
PORT=8000

# Optional — Gemini (shadow interview questions/scoring, skill gaps, referral pitch draft).
# Resume PDF parsing uses PyMuPDF heuristics only; it does not call Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
