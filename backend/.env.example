GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Comma-separated. Auto-adds 127.0.0.1 mirrors and Vite fallback ports 5173–5180 for localhost/127.
CORS_ORIGINS=http://localhost:5173
PORT=8000

# Optional — Gemini via google-genai SDK (shadow interview, skill gaps, referral pitch draft).
# Resume PDF parsing uses PyMuPDF heuristics only; it does not call Gemini.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
